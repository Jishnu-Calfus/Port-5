# Ollama server (local) — no API key needed
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Postgres (local, native install via Postgres.app — see README for setup)
DATABASE_URL=postgresql+psycopg2://pulseai:pulseai@localhost:5432/pulseai

# Read-only Postgres role for the data agent (SELECT-only grants -- see
# AGENT.md for the exact CREATE ROLE/GRANT statements). A different
# role from DATABASE_URL above on purpose: the data agent's safety story
# depends on this connection being physically unable to write.
DATABASE_READ_URL=postgresql+psycopg2://pulseai_ro:pulseai_ro@localhost:5432/pulseai

# OpenAI (the data agent is the one feature that uses a paid, hosted model
# instead of local Ollama -- see AGENT.md). Never commit a real key;
# this file is checked into git, only .env (gitignored) should hold one.
OPENAI_API_KEY=
AGENT_MODEL=gpt-4.1-mini
AGENT_MAX_TURNS=8
